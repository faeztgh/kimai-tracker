{
  "name": "kimai-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Kimai Tracker — a fast, lightweight desktop time-tracking app for self-hosted Kimai. Tray popover and floating widget for Windows, macOS and Linux.",
  "author": {
    "name": "faeztgh",
    "email": "contact@faez.pro",
    "url": "https://github.com/faeztgh"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/faeztgh/kimai-tracker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faeztgh/kimai-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/faeztgh/kimai-tracker/issues"
  },
  "keywords": [
    "kimai",
    "kimai-client",
    "kimai-desktop",
    "time-tracking",
    "time-tracker",
    "timesheet",
    "self-hosted",
    "desktop-app",
    "electron",
    "system-tray",
    "productivity",
    "windows",
    "macos",
    "linux",
    "faeztgh"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm run build && pnpm test:e2e",
    "pack:dir": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder --publish always",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "45",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.5.11",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "esbuild": "^0.28.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller",
      "lefthook"
    ]
  }
}
